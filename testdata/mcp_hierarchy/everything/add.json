{
  "tools": {
    "add": {
      "description": "Adds two numbers",
      "maps_to": "add",
      "server": "everything",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "a": {
            "description": "First number",
            "type": "number"
          },
          "b": {
            "description": "Second number",
            "type": "number"
          }
        },
        "required": [
          "a",
          "b"
        ],
        "type": "object"
      }
    }
  }
}
