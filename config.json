{
  "mcpProxy": {
    "baseURL": "http://localhost",
    "addr": ":9090",
    "name": "Tappet",
    "version": "0.1.0",
    "type": "stdio",
    "hierarchyPath": "testdata/mcp_hierarchy"
  },
  "mcpServers": {
    "serena": {
      "transportType": "stdio",
      "command": "uvx",
      "args": [
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code"
      ],
      "env": {}
    },
    "github": {
      "transportType": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "transportType": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/repos",
        "${HOME}/Documents"
      ],
      "env": {}
    },
    "everything": {
      "transportType": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything@2025.9.25"
      ],
      "env": {}
    }
  }
}
