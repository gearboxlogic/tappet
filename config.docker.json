{
  "mcpProxy": {
    "baseURL": "http://localhost:9090",
    "addr": ":9090",
    "name": "Tappet",
    "version": "0.1.0",
    "type": "streamable-http",
    "capabilityPath": "/config/capabilities"
  },
  "mcpServers": {
    "everything": {
      "transportType": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything@2025.9.25"
      ],
      "env": {}
    }
  }
}
